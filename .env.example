# 将此文件复制为 .env.local。密钥只保存在服务端，不放进浏览器或Git。
# base URL应包含服务商要求的版本路径，例如 https://your-provider.example/v1
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
# 嵌入服务可以与文本模型不同。未设置BASE_URL/API_KEY时复用AI配置。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
# 默认只返回原文片段；有配置且索引完成后可用向量检索和大模型回答。
RAG_DATA_DIR=./data
