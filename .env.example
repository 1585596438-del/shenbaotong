# 将此文件复制为 .env.local。密钥只保存在服务端，不放进浏览器或Git。
# 默认示例使用OpenAI官方API；使用其他兼容服务时替换地址与模型名。
# base URL应包含服务商要求的版本路径。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
# 嵌入服务可以与文本模型不同。未设置BASE_URL/API_KEY时复用AI配置。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-3-small
# 默认只返回原文片段；有配置且索引完成后可用向量检索和大模型回答。
RAG_DATA_DIR=./data
