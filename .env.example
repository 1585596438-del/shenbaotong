# 将此文件复制为 .env.local。密钥只保存在服务端，不放进浏览器或Git。
# 默认使用智谱免费文本模型；使用其他兼容服务时替换地址与模型名。
# base URL应包含服务商要求的版本路径。
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_API_KEY=
AI_CHAT_MODEL=glm-4-flash-250414
# 嵌入服务可以与文本模型不同。未设置BASE_URL/API_KEY时复用AI配置。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 免费方案先保留此项为空，使用关键词检索，不请求嵌入API。
AI_EMBEDDING_MODEL=
# 文本模型与嵌入模型独立：只配置文本模型即可生成带原文引用的回答。
RAG_DATA_DIR=./data
